/* 欢迎页 */
.hero { text-align: center; padding: 96rpx 48rpx 64rpx; }
.logo {
  display: inline-block; background: #002FA7; color: #fff;
  font-size: 44rpx; font-weight: 700; letter-spacing: 8rpx;
  padding: 16rpx 36rpx; border-radius: 16rpx; margin-bottom: 40rpx;
}
.h1 { font-size: 44rpx; font-weight: 700; margin-bottom: 20rpx; }
.sub { font-size: 26rpx; color: #6B7085; line-height: 1.7; }
.theory {
  margin: 32rpx auto 0; font-size: 24rpx; color: #6B7085;
  background: #EEF1FB; border-radius: 12rpx; padding: 20rpx 28rpx;
  width: fit-content; line-height: 1.7;
}
.stats { display: flex; justify-content: center; gap: 48rpx; margin: 48rpx 0 16rpx; }
.stat { display: flex; flex-direction: column; }
.stat .n { font-size: 48rpx; font-weight: 700; color: #002FA7; }
.stat .t { font-size: 22rpx; color: #6B7085; margin-top: 4rpx; }

/* 支付解锁框 */
.paybox {
  margin-top: 48rpx; background: #fff; border-radius: 20rpx;
  padding: 40rpx 36rpx 36rpx; box-shadow: 0 6rpx 40rpx rgba(26,31,54,.08);
}
.pay-price { font-size: 72rpx; font-weight: 800; color: #002FA7; }
.pay-desc { font-size: 24rpx; color: #6B7085; margin: 12rpx 0 8rpx; }
.pay-btn { margin-top: 24rpx; }
